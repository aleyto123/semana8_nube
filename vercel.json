{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["app.py", "storage.py", "vercel_app.py", "index.html", "styles.css", "app.js", "screens.js", "data.js", "favicon.svg"]
      }
    }
  ],
  "routes": [{"src": "/(.*)", "dest": "/api/index.py"}]
}
